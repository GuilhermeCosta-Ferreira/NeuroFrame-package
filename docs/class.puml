@startuml
left to right direction
skinparam linetype ortho
skinparam class {
BackgroundColor<<implemented>> #D5F5D5
BorderColor<<implemented>> #2E7D32
FontColor<<implemented>> #1B5E20

BackgroundColor<<partial>> #FFF3CD
BorderColor<<partial>> #B8860B
FontColor<<partial>> #7A5600

BackgroundColor<<planned>> #F8D7DA
BorderColor<<planned>> #B02A37
FontColor<<planned>> #842029

BackgroundColor<<external>> #E3F2FD
BorderColor<<external>> #1565C0
FontColor<<external>> #0D47A1
}

legend right
|= Colour |
|<#D5F5D5> Implemented |
|<#FFF3CD> Partially implemented |
|<#F8D7DA> Planned / not implemented |
|<#E3F2FD> External dependency |
endlegend

' 0 = hide dependency lines
' 1 = show dependency lines
!$SHOW_DEPENDENCIES = 0


'=============================================================================='
'Service Layer'
'=============================================================================='
package "Service Layer" #E8F5E9 {

}



'=============================================================================='
'Model Domain'
'=============================================================================='
package "Model Domain Layer" #FFF8E1 {
    enum Orientation <<planned>> {
        + PSL
        + ASL
        + PIM
        ...
    }

    package "Volumetric Containers"{
        enum VolumeKey <<planned>> {
            + DEFAULT
            + MRI
            + uCT
            + SEGMENTATION
        }


        abstract class VolumeData <<planned>> {
            + data: NDArray
            + key: VolumeKey
            + resolution: tuple[float, float, float]
            + unit: tuple[str, str, str]
            + orientation: Orientation
            + shape: tuple[int, int, int]

            - _contains_labels: bool = False

            + copy_with(): Self
        }
        VolumeData --> VolumeKey
        VolumeData --> Orientation


        class MRI <<planned>> {
            + copy_with(): Self
        }
        MRI --|> VolumeData


        class uCT <<planned>> {
            + copy_with(): Self
        }
        uCT --|> VolumeData


        class Segmentation <<planned>> {
            + look_up: pd.DataFrame
            + segment_labels: list[int]
            + background_segment: int

            + copy_with(): Self
        }
        Segmentation --|> VolumeData
    }


    package "Planar Containers"{
        enum PlaneKey <<planned>> {
            + DEFAULT
            + SKULL_PROJECTION
        }


        abstract class PlaneData <<planned>> {
            + data: NDArray
            + key: PlaneKey
            + resolution: tuple[float, float]
            + unit: tuple[str, str]
            + orientation: Orientation
            + shape: tuple[int, int]

            - _contains_labels: bool = False

            + copy_with(): Self
        }
        PlaneData --> PlaneKey
        PlaneData --> Orientation


        class SkullProjection <<planned>> {
            + method_name: str
        }
        SkullProjection --|> PlaneData
    }


    package "Data Containers"{
        enum TableKey <<planned>> {
            + DEFAULT
        }


        abstract class TableData <<planned>> {
            + data: pl.DataFrame
            + key: TableKey
            + description: str | None

            + copy_with(): Self
        }
        TableData --> TableKey


        enum SeriesKey <<planned>> {
            + DEFAULT
        }

        abstract class SeriesData <<planned>> {
            + x: NDArray
            + y: NDArray
            + key: SeriesKey
            + x_label: str
            + y_label: str
            + x_unit: str | None
            + y_unit: str | None

            + copy_with(): Self
        }
        SeriesData --> SeriesKey


        enum PlotKey <<planned>> {
            + DEFAULT
        }


        abstract class PlotSpec <<planned>> {
            + key: PlotKey
            + title: str
            + x_label: str | None
            + y_label: str | None
            + parameters: dict[str, Any]

            + copy_with(): Self
        }
        PlotSpec --> PlotKey
    }


    class MouseData <<planned>> {
        + volumes: dict[VolumeKey, VolumeData]
        + planes: dict[PlaneKey, PlaneData]
        + tables: dict[TableKey, TableData]
        + series: dict[SeriesKey, SeriesData]
        + plot_specs: dict[PlotKey, PlotSpec]

        + copy_with(): Self
    }
    MouseData o-- VolumeData
    MouseData o-- VolumeKey
    MouseData o-- PlaneData
    MouseData o-- PlaneKey
    MouseData o-- TableData
    MouseData o-- TableKey
    MouseData o-- SeriesData
    MouseData o-- SeriesKey
    MouseData o-- PlotSpec
    MouseData o-- PlotKey


    package "Transformations"{
        interface AbstractTransformation <<planned>>{
            + apply(batch: SampleBatch): SampleBatch
        }
        !if ($SHOW_DEPENDENCIES == 1)
        AbstractTransformation ..> MouseData
        !endif


        class OrientMouse <<planned>> {
            + target_orientation: Orientation

            - _orient_volume(...): VolumeData
        }
        OrientMouse ..|> AbstractTransformation
        OrientMouse --> Orientation
        !if ($SHOW_DEPENDENCIES == 1)
        OrientMouse ..> VolumeData
        !endif


        class OtherTransformations <<planned>> {
            + hyperparameters: Any

            - _helper_functions(inputs): Any
        }
        OtherTransformations ..|> AbstractTransformation


        note right of OtherTransformations
        This includes all of the otehr transformations.
        Please refer to the transformation diagram for
        more information

        Examples:
        - OrientMouse
        - NormaliseIntensity
        - AlignToPCA
        - ExtractSkullSurface
        - ExtractBLSpace
        end note
    }


    class PipelineSpec <<planned>> {
        + pipeline_name: str
        + steps: list[Type[AbstractTransformation]]
        + config: PipelineConfig

        + add_step(step: Type[AbstractTransformation]): None
        + add_list(steps: list[Type[AbstractTransformation]]): None
        + insert_step(index: int, step: Type[AbstractTransformation]): None
        + remove_step(index: int): None
        + clear(): None
    }
    PipelineSpec ..> AbstractTransformation : step types


    package "Config" {
        class PipelineConfig <<planned>> {
            + config: Mapping[str, Any]
            {static} + RESERVED_KEYS: set[str]

            + mouse: str
            + pipeline_id: int
            + pipeline_name: str

            + step_names: list[str]

            + __post_init__(): None
            + validate(): None

            + has_step(step_name: str): bool
            + step_params(step_name: str): dict[str, Any]
            + step_config(step_name: str): StepConfig
            + step_configs(ordered_step_names: list[str]): list[StepConfig]
            + to_dict(): dict[str, Any]

            - _require_key(key: str): None
        }
        PipelineConfig o-- StepConfig


        class StepConfig <<planned>> {
            + name: str
            + enabled: bool
            + parameters: dict
        }
    }


    package "Execution Metadata"{
        class StepSignature <<planned>> {
            + step_name: str
            + params_hash: str
            + input_hash: str
            + code_hash: str
            + value: str
        }

        class StepManifest <<planned>> {
            + pipeline_id: int
            + step_id: int
            + step_name: str
            + signature: str
            + status: StepStatus
            + source_pipeline_id: int | None
            + source_step_id: int | None
        }
        StepManifest --> StepStatus

        enum StepStatus <<planned>> {
            + MATERIALIZED
            + REDIRECT
        }
    }
}



'=============================================================================='
'Adapter Layer'
'=============================================================================='
package "Adapter Layer" #E3F2FD {
    class Source <<planned>> {
        + mouse: str
        + base_path: Path

        + folder_path: Path
        + file_base_name: str
        + raw_path: Path
    }


    class Repository <<planned>> {
        + source: Source

        - _pipeline_base_name: str
        - _config_path: Path

        + init_project(): None
        + init_new_pipleine(pipeline_id: int): None
    }
    Repository --> Source


    class DataLoader <<planned>>{
        + source: Source

        - _raw_loader: RawDataLoader
        - _step_loader: StepDataLoader

        + load_metadata() -> dict
        + load_raw(): MouseData
        + load_batch(pipeline_id: int, step_id: int): MouseData
    }
    DataLoader --> Source
    DataLoader --> RawDataLoader
    DataLoader --> StepDataLoader
    !if ($SHOW_DEPENDENCIES == 1)
    DataLoader ..> MouseData
    !endif


    class RawDataLoader <<planned>>{
        + load_volume(): VolumeData
    }
    !if ($SHOW_DEPENDENCIES == 1)
    RawDataLoader ..> VolumeData
    !endif


    class StepDataLoader <<planned>>{
        + load_volume(paths: list[Path]): VolumeData
        + load_plane(paths: list[Path]): PlaneData
        + load_table(paths: list[Path]): TableData
        + load_series(paths: list[Path]): SeriesData
        + load_plots(paths: list[Path]): PlotSpec
    }
    !if ($SHOW_DEPENDENCIES == 1)
    StepDataLoader ..> VolumeData
    StepDataLoader ..> PlaneData
    StepDataLoader ..> TableData
    StepDataLoader ..> SeriesData
    StepDataLoader ..> PlotSpec
    !endif
}



'=============================================================================='
'Broken Links'
'=============================================================================='
PipelineSpec *-- PipelineConfig
@enduml



'!if ($SHOW_DEPENDENCIES == 1)'
